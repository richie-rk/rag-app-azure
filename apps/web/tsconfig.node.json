{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "vite.config.test.ts",
    "openapi-ts.config.ts",
    "scripts/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test"
  ]
}
