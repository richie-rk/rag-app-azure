# rag-app-azure Environment Variables
# Copy to .env and fill in your Azure resource values.

# Database
# SQLAlchemy connection string for Azure SQL
# Format: mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
DEFAULT_LLM_DEPLOYMENT=gpt-4o
EMBEDDING_DEPLOYMENT=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
DEFAULT_BLOB_CONTAINER=documents

# Azure Table Storage
AZURE_TABLE_NAME=chatsessions

# Authentication
JWT_SECRET=<generate-a-strong-random-secret>
MAGIC_LINK_BASE_URL=https://<your-app-domain>/auth/verify
MSAL_CLIENT_ID=<entra-app-registration-client-id>
MSAL_TENANT_ID=<entra-tenant-id>
# Comma-separated Entra ID group object IDs that grant app access
ALLOWED_AD_GROUPS=

# Search Defaults
DEFAULT_TOP_K=10

# CORS (chat service)
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (prefix with VITE_ for Vite)
# Set in ui/.env
# VITE_CHAT_API_URL=http://localhost:8000
# VITE_UTILS_API_URL=http://localhost:7071/api
# VITE_MSAL_CLIENT_ID=
# VITE_MSAL_TENANT_ID=
# VITE_MSAL_REDIRECT_URI=http://localhost:5173
